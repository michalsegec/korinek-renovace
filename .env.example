# Copy this file to .env.local and fill in your own values.
# .env.local is never uploaded to GitHub (it's in .gitignore).

# API key from resend.com (free plan is enough for a small business)
RESEND_API_KEY=

# Who sends the email (must be a domain verified in Resend; for testing use onboarding@resend.dev)
CONTACT_FROM_EMAIL=Web Kořínek <onboarding@resend.dev>

# Where inquiries arrive
CONTACT_TO_EMAIL=

# Google Analytics ID (G-XXXXXXX). Loads only after the visitor agrees in the cookie banner.
NEXT_PUBLIC_GA_ID=
